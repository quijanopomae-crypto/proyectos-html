{
  "$schema": "../cloudflare-lab/node_modules/wrangler/config-schema.json",
  "name": "cliente-001-pos-api",
  "main": "../cloudflare-lab/src/worker-entry.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "RUNTIME_ENVIRONMENT": "production",
    "CANONICAL_RUNTIME_ENABLED": "enabled",
    "DB_PROVIDER": "turso",
    "ASSISTANT_ENABLED": "1",
    "AI_PROVIDER": "ohmyagent"
  },
  "secrets": {
    "required": ["TURSO_DATABASE_URL", "TURSO_AUTH_TOKEN", "POS_ACTIVATION_SECRET", "ASSISTANT_CONFIRM_SECRET"]
  }
}
